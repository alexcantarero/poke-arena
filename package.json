{
  "name": "poke-arena",
  "version": "0.70.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "archetypes:sync": "tsx scripts/sync-archetypes.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "invite": "tsx scripts/create-invite.ts",
    "verificar:fase-a": "node --conditions=react-server --import=tsx scripts/verificar-fase-a.ts",
    "verificar:codificacion": "node scripts/verificar-codificacion.mjs",
    "db:migrar": "node scripts/migrar.mjs",
    "verificar:acciones": "node scripts/verificar-acciones.mjs",
    "verificar:i18n": "node scripts/verificar-i18n.mjs",
    "verificar": "node scripts/verificar-codificacion.mjs && node scripts/verificar-acciones.mjs && node scripts/verificar-i18n.mjs --estricto && npm test && tsc --noEmit",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^1.46.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
