# Cadena de conexión pooled de la rama DEV de Neon.
# Nunca pongas aquí la URL de producción; este archivo es solo una plantilla.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Código que tus amigos escriben la primera vez que entran.
# También se puede cambiar desde Ajustes una vez dentro.
LEAGUE_INVITE_CODE="ARENA26"

# ---------------------------------------------------------------------------
# Fuentes externas. Las dos son OPCIONALES: la app arranca y funciona entera
# sin ninguna de las dos, solo se queda sin el metagame mundial y sin el
# buscador de cartas.
# ---------------------------------------------------------------------------

# Limitless TCG. Los endpoints que usa Arena —torneos y clasificaciones—
# responden SIN clave, así que esto normalmente se deja vacío. Solo tiene
# sentido si algún día te conceden una: entonces se usa además el catálogo
# oficial de arquetipos, que va mejor.
# LIMITLESS_API_KEY=""

# El buscador de cartas del editor de mazos usa TCGdex (https://tcgdex.dev),
# que es gratis, abierta y NO necesita clave. No hay nada que configurar aquí.
# (Hasta la v0.28 la fuente era pokemontcg.io, deprecada: sus claves dejan de
# funcionar el 1 de marzo de 2027. Ya no se usa.)
