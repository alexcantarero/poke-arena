# Cadena de conexión de Neon (Dashboard → Connection string → "Pooled connection")
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Código que tus amigos escriben la primera vez que entran.
# También se puede cambiar desde Ajustes una vez dentro.
LEAGUE_INVITE_CODE="ARENA26"
